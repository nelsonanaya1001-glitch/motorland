<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="h-full antialiased">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#dc2626">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    <!-- One consistent font across the whole site -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind (CDN). Fine to launch with; for production, compile Tailwind
         to a static asset and replace this script + inline config. -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] } } } };
    </script>
    <style>
      /* Force the SAME font on every element (including imported product
         descriptions and form controls) so nothing falls back to the
         browser's serif/default font. */
      *, *::before, *::after {
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
      }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
      .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

      /* Imported product descriptions: keep them centered, readable, and
         make any images/tables responsive and centered instead of pinned
         to one side. */
      .product-description { line-height: 1.7; }
      .product-description img {
        max-width: 100%; height: auto; display: block;
        margin-left: auto; margin-right: auto; border-radius: 8px;
      }
      .product-description table { max-width: 100%; margin-left: auto; margin-right: auto; }
      .product-description h1, .product-description h2, .product-description h3 { font-weight: 700; margin: 1rem 0 .5rem; }
      .product-description p { margin: .5rem 0; }
      .product-description * { max-width: 100%; }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-white text-gray-900">
    {% section 'header' %}

    <main class="flex-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
  </body>
</html>
