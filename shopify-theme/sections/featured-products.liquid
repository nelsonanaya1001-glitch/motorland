<section class="py-20 px-4 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-12">
      <div>
        <p class="text-red-600 text-xs font-bold uppercase tracking-[0.2em] mb-2">{{ section.settings.eyebrow }}</p>
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="flex items-center gap-2 text-sm font-bold text-gray-900 hover:text-red-600 transition-colors uppercase tracking-wider border-b-2 border-gray-900 hover:border-red-600 pb-0.5">View All {% render 'icon', name: 'arrow-right', size: 16 %}</a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {%- assign products = section.settings.collection.products -%}
      {%- if products == empty or products == blank -%}{%- assign products = collections.all.products -%}{%- endif -%}
      {%- for product in products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hand-Picked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Parts" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
