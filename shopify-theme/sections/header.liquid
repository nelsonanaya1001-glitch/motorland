<header class="sticky top-0 z-50 shadow-md" x-data="{ menuOpen: false, searchOpen: false }">
  <!-- Top bar -->
  <div class="bg-[#111111] text-white text-xs py-2 px-4 text-center">
    {{ section.settings.announcement }} &nbsp;|&nbsp; Call us:
    <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="font-semibold hover:text-red-400 transition-colors">{{ section.settings.phone }}</a>
  </div>

  <!-- Main nav -->
  <nav class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="{{ routes.root_url }}" class="flex items-center gap-3 shrink-0">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" width="60" height="60" class="rounded-full object-cover w-[60px] h-[60px]">
          {%- endif -%}
          <span class="leading-tight">
            <span class="block text-xl font-extrabold tracking-tight text-[#111]">MOTORLAND</span>
            <span class="block text-sm font-semibold text-red-600 tracking-widest uppercase">Miami</span>
          </span>
        </a>

        <!-- Desktop nav links -->
        <div class="hidden md:flex items-center gap-8 text-sm font-semibold text-gray-700">
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}" class="hover:text-red-600 transition-colors">{{ link.title }}</a>
          {%- endfor -%}
        </div>

        <!-- Right icons -->
        <div class="flex items-center gap-2">
          <button type="button" onclick="document.getElementById('header-search').classList.toggle('hidden')" class="p-2 text-gray-500 hover:text-red-600 transition-colors" aria-label="Search">
            {% render 'icon', name: 'search' %}
          </button>
          <a href="{{ routes.account_url }}" class="p-2 text-gray-500 hover:text-red-600 transition-colors hidden sm:block" aria-label="Account">
            {% render 'icon', name: 'user' %}
          </a>
          <a href="{{ routes.cart_url }}" class="relative p-2 text-gray-500 hover:text-red-600 transition-colors" aria-label="Cart">
            {% render 'icon', name: 'cart' %}
            <span class="absolute top-1 right-1 bg-red-600 text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center">{{ cart.item_count }}</span>
          </a>
          <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="md:hidden p-2 text-gray-500 hover:text-red-600 transition-colors" aria-label="Menu">
            {% render 'icon', name: 'menu' %}
          </button>
        </div>
      </div>

      <!-- Search bar -->
      <div id="header-search" class="pb-4 hidden">
        <form action="{{ routes.search_url }}" method="get" class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">{% render 'icon', name: 'search', size: 16 %}</span>
          <input type="search" name="q" placeholder="Search by part name, make, model, year..." class="w-full border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 transition-colors">
        </form>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden pb-4 hidden flex-col gap-4 text-sm font-semibold text-gray-700 border-t border-gray-100 pt-4">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="block hover:text-red-600 transition-colors">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "305 716 9794" },
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Free shipping on orders over $75" }
  ]
}
{% endschema %}
