<section class="py-20 px-4 bg-[#111] relative overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-1 bg-red-600"></div>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-red-500 text-xs font-bold uppercase tracking-[0.2em] mb-2">{{ section.settings.eyebrow }}</p>
      <h2 class="text-4xl font-black text-white tracking-tight">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        <div class="bg-white/5 border border-white/10 rounded-xl p-8 hover:border-red-600/50 transition-colors" {{ block.shopify_attributes }}>
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-5 text-white">{% render 'icon', name: block.settings.icon, size: 24 %}</div>
          <h3 class="text-white font-bold text-lg mb-2">{{ block.settings.title }}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value Props",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why choose us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built Different." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "layers", "options": [
          { "value": "layers", "label": "Layers" }, { "value": "dollar", "label": "Dollar" }, { "value": "check", "label": "Check" },
          { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" } ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Value Props", "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }] }]
}
{% endschema %}
