<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }}</title><script src="https://cdn.tailwindcss.com"></script>{{ content_for_header }}</head>
<body class="min-h-screen bg-[#1a0a0a] text-white flex items-center justify-center px-4">
  <div class="max-w-md w-full text-center">
    <h1 class="text-4xl font-black tracking-tight mb-2">MOTORLAND <span class="text-red-500">MIAMI</span></h1>
    <p class="text-gray-400 mb-8">Opening soon. Enter the password to preview the store.</p>
    {% form 'storefront_password' %}
      {%- if form.errors -%}<p class="text-red-400 text-sm mb-3">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="flex gap-2">
        <input type="password" name="password" placeholder="Password" class="flex-1 rounded-md px-4 py-3 text-gray-900 focus:outline-none">
        <button type="submit" class="bg-red-600 hover:bg-red-700 font-bold px-6 py-3 rounded-md uppercase text-sm tracking-widest">Enter</button>
      </div>
    {% endform %}
  </div>
</body></html>
