<div class="bg-white min-h-screen">
  <!-- Header -->
  <div class="bg-gray-50 border-b border-gray-200 py-10 px-4 text-center">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ page.title | default: 'Contact Us' }}</h1>
    <p class="text-gray-500 text-sm">We&apos;re here to help. Reach out and we&apos;ll get back to you quickly.</p>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact info -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-6">Get in touch</h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-11 h-11 bg-red-50 rounded-xl flex items-center justify-center shrink-0 text-red-600">{% render 'icon', name: 'phone' %}</div>
            <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</p><a href="tel:{{ settings.phone | remove: ' ' }}" class="text-lg font-bold text-gray-900 hover:text-red-600 transition-colors">{{ settings.phone }}</a></div>
          </div>
          <div class="flex gap-4">
            <div class="w-11 h-11 bg-red-50 rounded-xl flex items-center justify-center shrink-0 text-red-600">{% render 'icon', name: 'mail' %}</div>
            <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p><a href="mailto:{{ settings.email }}" class="text-base font-semibold text-gray-900 hover:text-red-600 transition-colors">{{ settings.email }}</a></div>
          </div>
          <div class="flex gap-4">
            <div class="w-11 h-11 bg-red-50 rounded-xl flex items-center justify-center shrink-0 text-red-600">{% render 'icon', name: 'map-pin' %}</div>
            <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p><p class="text-base font-semibold text-gray-900">Miami, Florida</p></div>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Send us a message</h2>
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <p class="mb-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-md px-3 py-2">Thanks! We&apos;ll get back to you shortly.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-3 py-2">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div><label class="block text-xs font-semibold text-gray-700 mb-1.5">Name</label><input type="text" name="contact[name]" placeholder="John Doe" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 bg-white"></div>
              <div><label class="block text-xs font-semibold text-gray-700 mb-1.5">Phone</label><input type="tel" name="contact[phone]" placeholder="(305) 555-0123" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 bg-white"></div>
            </div>
            <div><label class="block text-xs font-semibold text-gray-700 mb-1.5">Email</label><input type="email" name="contact[email]" required placeholder="john@example.com" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 bg-white"></div>
            <div><label class="block text-xs font-semibold text-gray-700 mb-1.5">Subject</label><input type="text" name="contact[subject]" placeholder="Part inquiry, order question..." class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 bg-white"></div>
            <div><label class="block text-xs font-semibold text-gray-700 mb-1.5">Message</label><textarea name="contact[body]" rows="5" required placeholder="Tell us what part you need, your vehicle make/model/year..." class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500 bg-white resize-none"></textarea></div>
            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-md transition-colors text-sm uppercase tracking-wide">Send Message</button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>
