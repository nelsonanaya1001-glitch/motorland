<div class="bg-white min-h-screen">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-8">Your Cart</h1>

    {%- if cart.item_count == 0 -%}
      <div class="text-center py-24">
        <p class="text-lg text-gray-500 mb-4">Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-md transition-colors text-sm uppercase tracking-widest">Browse Parts {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="space-y-4 mb-8">
          {%- for item in cart.items -%}
            <div class="flex gap-4 border border-gray-200 rounded-xl p-4 items-center">
              <a href="{{ item.url }}" class="w-20 h-20 bg-gray-50 rounded-lg overflow-hidden shrink-0">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">{%- endif -%}
              </a>
              <div class="flex-1 min-w-0">
                <a href="{{ item.url }}" class="text-sm font-semibold text-gray-900 hover:text-red-600 transition-colors line-clamp-2">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="text-xs text-gray-500 mt-1">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="text-red-600 font-bold mt-1">{{ item.final_price | money }}</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-16 border border-gray-300 rounded-md px-2 py-1.5 text-sm text-center text-gray-800 focus:outline-none focus:border-red-500">
                <a href="{{ item.url_to_remove }}" class="text-xs text-gray-400 hover:text-red-600 transition-colors">Remove</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-gray-200 pt-6">
          <button type="submit" name="update" class="text-sm text-gray-600 hover:text-red-600 underline order-2 sm:order-1">Update cart</button>
          <div class="order-1 sm:order-2 text-right">
            <p class="text-sm text-gray-500 mb-2">Subtotal <span class="text-2xl font-black text-gray-900 ml-2">{{ cart.total_price | money }}</span></p>
            <p class="text-xs text-gray-400 mb-4">Shipping &amp; taxes calculated at checkout</p>
            <button type="submit" name="checkout" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-3.5 rounded-md transition-colors text-sm uppercase tracking-widest">Checkout</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>
