<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }} Gift Card</title><script src="https://cdn.tailwindcss.com"></script>{{ content_for_header }}</head>
<body class="min-h-screen bg-white text-gray-900 flex items-center justify-center px-4">
  <div class="max-w-md w-full text-center border border-gray-200 rounded-2xl p-10">
    <h1 class="text-2xl font-black tracking-tight mb-2">Gift Card</h1>
    <p class="text-4xl font-extrabold text-red-600 my-4">{{ gift_card.balance | money }}</p>
    {{ gift_card.qr_identifier }}
    <p class="text-sm text-gray-500 mt-4">Use this code at checkout:</p>
    <p class="font-mono text-lg font-bold tracking-wider">{{ gift_card.code | format_code }}</p>
  </div>
</body></html>
