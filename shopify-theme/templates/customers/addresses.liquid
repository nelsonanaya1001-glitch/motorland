<div class="bg-white min-h-screen"><div class="max-w-3xl mx-auto px-4 py-16">
  <a href="{{ routes.account_url }}" class="text-sm text-gray-500 hover:text-red-600">&larr; Account</a>
  <h1 class="text-2xl font-black text-gray-900 mt-4 mb-8">Addresses</h1>
  {%- for address in customer.addresses -%}
    <div class="border border-gray-200 rounded-lg p-4 mb-4 text-sm text-gray-700">
      {{ address | format_address }}
    </div>
  {%- else -%}<p class="text-gray-400 text-sm">No saved addresses.</p>{%- endfor -%}
</div></div>
