<div class="bg-white min-h-screen"><div class="max-w-md mx-auto px-4 py-16">
  <h1 class="text-2xl font-black text-gray-900 mb-6 text-center">Create account</h1>
  {% form 'create_customer' %}
    {%- if form.errors -%}<p class="text-red-600 text-sm mb-3">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <input type="text" name="customer[first_name]" placeholder="First name" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
        <input type="text" name="customer[last_name]" placeholder="Last name" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
      </div>
      <input type="email" name="customer[email]" placeholder="Email" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
      <input type="password" name="customer[password]" placeholder="Password" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
      <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-md text-sm uppercase tracking-wide">Create Account</button>
    </div>
  {% endform %}
  <p class="text-sm text-gray-500 text-center mt-6">Already have an account? <a href="{{ routes.account_login_url }}" class="text-red-600 hover:underline">Log in</a></p>
</div></div>
