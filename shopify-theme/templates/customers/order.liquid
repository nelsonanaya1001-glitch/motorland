<div class="bg-white min-h-screen"><div class="max-w-4xl mx-auto px-4 py-16">
  <a href="{{ routes.account_url }}" class="text-sm text-gray-500 hover:text-red-600">&larr; Account</a>
  <h1 class="text-2xl font-black text-gray-900 mt-4 mb-2">Order {{ order.name }}</h1>
  <p class="text-sm text-gray-500 mb-8">Placed {{ order.created_at | date: '%B %d, %Y' }}</p>
  <div class="space-y-3 mb-8">
    {%- for line in order.line_items -%}
      <div class="flex justify-between border border-gray-200 rounded-lg px-4 py-3 text-sm">
        <span class="text-gray-900">{{ line.title }} &times; {{ line.quantity }}</span>
        <span class="text-red-600 font-bold">{{ line.final_line_price | money }}</span>
      </div>
    {%- endfor -%}
  </div>
  <p class="text-right font-black text-xl text-gray-900">Total: {{ order.total_price | money }}</p>
</div></div>
