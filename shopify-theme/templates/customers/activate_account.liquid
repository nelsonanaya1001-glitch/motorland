<div class="bg-white min-h-screen"><div class="max-w-md mx-auto px-4 py-16">
  <h1 class="text-2xl font-black text-gray-900 mb-6 text-center">Activate account</h1>
  {% form 'activate_customer_password' %}
    {%- if form.errors -%}<p class="text-red-600 text-sm mb-3">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="space-y-4">
      <input type="password" name="customer[password]" placeholder="Password" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" class="w-full border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
      <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-md text-sm uppercase tracking-wide">Activate</button>
      <button type="submit" name="decline" class="w-full text-sm text-gray-500 hover:text-red-600">Decline invitation</button>
    </div>
  {% endform %}
</div></div>
