{%- paginate collection.products by 24 -%}
<div class="bg-white min-h-screen">
  <!-- Page header -->
  <div class="bg-[#111] border-b border-white/10 py-10 px-4 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-red-600"></div>
    <div class="max-w-7xl mx-auto pl-4">
      <nav class="text-xs text-gray-500 mb-3 flex gap-1">
        <a href="{{ routes.root_url }}" class="hover:text-red-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gray-300">{{ collection.title }}</span>
      </nav>
      <h1 class="text-4xl font-black text-white tracking-tight">{{ collection.title }}</h1>
      <p class="text-gray-400 text-sm mt-1">{{ collection.products_count }} parts available</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex gap-8">
      <!-- Sidebar -->
      <aside class="hidden lg:block w-52 shrink-0">
        <div class="sticky top-36 space-y-6">
          <div>
            <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-3">Category</h3>
            <ul class="space-y-0.5">
              <li><a href="{{ routes.all_products_collection_url }}" class="block text-sm px-2 py-1.5 rounded transition-colors {% if collection.handle == 'all' %}bg-red-50 text-red-600 font-semibold{% else %}text-gray-600 hover:text-red-600 hover:bg-gray-50{% endif %}">All Parts</a></li>
              {%- for c in collections -%}
                {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
                  <li><a href="{{ c.url }}" class="block text-sm px-2 py-1.5 rounded transition-colors {% if collection.handle == c.handle %}bg-red-50 text-red-600 font-semibold{% else %}text-gray-600 hover:text-red-600 hover:bg-gray-50{% endif %}">{{ c.title }}</a></li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </aside>

      <!-- Product grid -->
      <div class="flex-1 min-w-0">
        <!-- Sort -->
        <form method="get" class="flex items-center justify-end mb-6 gap-2">
          <span class="text-gray-400">{% render 'icon', name: 'search', size: 16 %}</span>
          <select name="sort_by" onchange="this.form.submit()" class="border border-gray-300 text-sm text-gray-700 rounded-md px-3 py-1.5 focus:outline-none focus:border-red-500 bg-white">
            {%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
            <option value="manual" {% if sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="best-selling" {% if sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="title-ascending" {% if sort == 'title-ascending' %}selected{% endif %}>A–Z</option>
            <option value="title-descending" {% if sort == 'title-descending' %}selected{% endif %}>Z–A</option>
          </select>
        </form>

        {%- if collection.products.size == 0 -%}
          <div class="text-center py-24 text-gray-400">
            <p class="text-lg mb-2">No parts found.</p>
            <a href="{{ routes.all_products_collection_url }}" class="text-red-600 hover:underline text-sm">Browse all parts</a>
          </div>
        {%- else -%}
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          <div class="flex justify-center items-center gap-2 mt-10">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:border-red-500 hover:text-red-600 transition-colors">Previous</a>
            {%- endif -%}
            <span class="text-sm text-gray-500 px-2">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:border-red-500 hover:text-red-600 transition-colors">Next</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}
