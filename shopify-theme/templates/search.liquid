{%- paginate search.results by 24 -%}
<div class="bg-white min-h-screen">
  <div class="bg-[#111] border-b border-white/10 py-10 px-4 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-red-600"></div>
    <div class="max-w-7xl mx-auto pl-4">
      <h1 class="text-4xl font-black text-white tracking-tight">Search</h1>
      <p class="text-gray-400 text-sm mt-1">{% if search.performed %}{{ search.results_count }} results for &ldquo;{{ search.terms | escape }}&rdquo;{% endif %}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <form action="{{ routes.search_url }}" method="get" class="relative mb-8 max-w-xl">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">{% render 'icon', name: 'search', size: 16 %}</span>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search parts..." class="w-full border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
    </form>

    {%- if search.results.size == 0 -%}
      <div class="text-center py-24 text-gray-400"><p class="text-lg">No results found.</p></div>
    {%- else -%}
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="flex justify-center items-center gap-2 mt-10">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:border-red-500 hover:text-red-600 transition-colors">Previous</a>{%- endif -%}
          <span class="text-sm text-gray-500 px-2">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:border-red-500 hover:text-red-600 transition-colors">Next</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}
