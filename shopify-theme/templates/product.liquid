<div class="bg-white min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
      <a href="{{ routes.root_url }}" class="hover:text-red-600 transition-colors">Home</a>
      <span>/</span>
      <a href="{{ routes.all_products_collection_url }}" class="hover:text-red-600 transition-colors">Catalog</a>
      <span>/</span>
      <span class="text-gray-800 truncate max-w-xs">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <!-- Image -->
      <div class="aspect-square bg-white border border-gray-200 rounded-2xl overflow-hidden flex items-center justify-center p-4">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape }}" class="max-w-full max-h-full object-contain">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ product.title | escape }}" class="max-w-[50%] max-h-[50%] object-contain opacity-25">
        {%- endif -%}
      </div>

      <!-- Details -->
      <div>
        {%- unless product.available -%}
          <span class="inline-block text-xs font-semibold text-gray-700 bg-gray-100 border border-gray-200 rounded px-2 py-1 mb-4">Sold out</span>
        {%- endunless -%}

        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug mb-4">{{ product.title }}</h1>

        <!-- Rating (static) -->
        <div class="flex items-center gap-2 mb-6">
          {%- for i in (1..5) -%}
            <span class="{% if i <= 4 %}text-yellow-400{% else %}text-gray-300{% endif %}">{% render 'icon', name: 'star', size: 16, fill: 'currentColor' %}</span>
          {%- endfor -%}
          <span class="text-sm text-gray-500">(24 reviews)</span>
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="product-form">
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          <div class="text-4xl font-extrabold text-red-600 mb-6" id="price">
            {{ current_variant.price | money }}
            <span class="text-base font-normal text-gray-400 ml-2">{{ cart.currency.iso_code }}</span>
          </div>

          {%- if product.type != blank -%}
            <p class="text-sm text-gray-500 mb-6">Category: <span class="text-gray-800 font-medium">{{ product.type }}</span></p>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            <div class="mb-6 space-y-4">
              {%- for option in product.options_with_values -%}
                <div>
                  <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wide mb-1.5">{{ option.name }}</label>
                  <select name="options[{{ option.name | escape }}]" class="border border-gray-300 rounded-md px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:border-red-500">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="return_to" value="/cart">

          <!-- Quantity + Add to cart -->
          <div class="flex gap-3 mb-8">
            <input type="number" name="quantity" value="1" min="1" class="w-20 border border-gray-300 rounded-md px-3 py-3 text-sm text-gray-800 text-center focus:outline-none focus:border-red-500">
            <button type="submit" class="flex-1 flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-md transition-colors disabled:opacity-50" {% unless product.available %}disabled{% endunless %}>
              {% render 'icon', name: 'cart' %} {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
          </div>
        </form>

        <!-- Trust signals -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 space-y-4">
          <div class="flex items-center gap-3 text-sm text-gray-700"><span class="text-red-600">{% render 'icon', name: 'truck' %}</span> Fast shipping — most orders ship within 1–2 business days</div>
          <div class="flex items-center gap-3 text-sm text-gray-700"><span class="text-red-600">{% render 'icon', name: 'package' %}</span> Wholesale pricing available for shops &amp; resellers</div>
          <div class="flex items-center gap-3 text-sm text-gray-700"><span class="text-red-600">{% render 'icon', name: 'refresh' %}</span> 30-day hassle-free returns</div>
          <div class="flex items-center gap-3 text-sm text-gray-700"><span class="text-red-600">{% render 'icon', name: 'shield' %}</span> Quality guaranteed — every part tested before shipping</div>
        </div>

      </div>
    </div>

    <!-- Description (full width, centered) -->
    {%- if product.description != blank -%}
      <div class="max-w-3xl mx-auto border-t border-gray-100 pt-10 mb-16">
        <h2 class="text-xl font-bold text-gray-900 mb-6 text-center">Product Details</h2>
        <div class="product-description text-gray-700 text-center">{{ product.description }}</div>
      </div>
    {%- endif -%}

    <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 text-gray-500 hover:text-red-600 transition-colors text-sm mb-12">{% render 'icon', name: 'arrow-left', size: 16 %} Back to catalog</a>

    <!-- Related -->
    {%- assign related = product.collections.first.products | default: collections.all.products -%}
    <div class="border-t border-gray-100 pt-12">
      <h2 class="text-xl font-bold text-gray-900 mb-6">You may also like</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {%- assign shown = 0 -%}
        {%- for rel in related -%}
          {%- if rel.id != product.id and shown < 4 -%}
            {% render 'product-card', product: rel %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  // Keep hidden variant id + price in sync with option selectors.
  (function () {
    var form = document.getElementById('product-form');
    if (!form) return;
    var variants = {{ product.variants | json }};
    var priceEl = document.getElementById('price');
    var idInput = form.querySelector('input[name="id"]');
    form.querySelectorAll('select[name^="options"]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var chosen = Array.from(form.querySelectorAll('select[name^="options"]')).map(function (s) { return s.value; });
        var match = variants.find(function (v) { return v.options.join() === chosen.join(); });
        if (match) {
          idInput.value = match.id;
          priceEl.firstChild.textContent = (match.price / 100).toLocaleString(undefined, { style: 'currency', currency: '{{ cart.currency.iso_code }}' }) + ' ';
        }
      });
    });
  })();
</script>
