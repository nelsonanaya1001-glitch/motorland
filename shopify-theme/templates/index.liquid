{%- comment -%}
  Self-contained homepage. No {% section %} or snippet dependencies so it
  always renders. Edit text/links/images directly below.
{%- endcomment -%}

<div class="bg-white text-gray-900">

  <!-- ── HERO ── -->
  <section class="relative overflow-hidden min-h-[600px] flex items-center bg-[#1a0a0a]">
    <div class="absolute inset-0">
      <img src="{{ 'hero.jpg' | asset_url }}" alt="Motorland Miami" class="w-full h-full object-cover object-center">
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-8 sm:px-10 lg:px-14 py-28 w-full">
      <div class="max-w-lg">
        <span class="inline-block border border-red-500 text-red-400 text-[11px] font-bold px-3 py-1 rounded-sm tracking-[0.2em] uppercase mb-5">Auto Parts &amp; Accessories</span>
        <h1 class="text-5xl sm:text-6xl font-black text-white leading-[1.05] tracking-tight mb-6">Quality Parts<br>for <span class="text-red-500">Every Make</span><br>&amp; Model.</h1>
        <p class="text-gray-300 text-base mb-10 leading-relaxed max-w-sm">Founded in 2020 — Motorland Miami ships reliable OEM and aftermarket parts straight from Miami, FL.</p>
        <div class="flex flex-wrap gap-3">
          <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-7 py-3.5 rounded-sm transition-colors text-sm uppercase tracking-widest">Shop All Parts &rarr;</a>
          <a href="/pages/contact" class="inline-flex items-center gap-2 border border-white/50 hover:border-white text-white font-bold px-7 py-3.5 rounded-sm transition-colors text-sm uppercase tracking-widest">Contact Us</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 bg-black/60 backdrop-blur-sm border-t border-white/10 z-10">
      <div class="max-w-7xl mx-auto px-8 py-3 flex gap-8 sm:gap-16 text-sm">
        <div class="text-white"><span class="font-bold text-white">5,000+</span> Parts in Stock</div>
        <div class="text-white"><span class="font-bold text-white">Est.</span> 2020 · Miami, FL</div>
        <div class="hidden sm:block text-white"><span class="font-bold text-white">Most</span> Brands Available</div>
      </div>
    </div>
  </section>

  <!-- ── BRANDS ── -->
  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-gray-200"></div>
        <h2 class="text-gray-900 text-sm font-bold uppercase tracking-[0.25em]">Shop by Brand</h2>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
        {%- assign brand_names = "BMW,Chevrolet,Mazda,Toyota,Ford,Nissan" | split: "," -%}
        {%- assign brand_imgs = "https://motorlandmia.com/cdn/shop/collections/bmw-logo-1997.webp?v=1769059521&width=400,https://motorlandmia.com/cdn/shop/collections/unnamed_1.jpg?v=1769060352&width=400,https://motorlandmia.com/cdn/shop/collections/Mazda.webp?v=1769059539&width=400,https://motorlandmia.com/cdn/shop/collections/unnamed_2.jpg?v=1769061874&width=400,https://motorlandmia.com/cdn/shop/collections/unnamed_3.jpg?v=1769061961&width=400,https://motorlandmia.com/cdn/shop/collections/2c140d83-5e05-4581-bad6-3ab8c362735f.png?v=1771015890&width=400" | split: "," -%}
        {%- for name in brand_names -%}
          <a href="{{ routes.search_url }}?q={{ name | downcase | url_encode }}" class="group bg-white hover:bg-red-600 border border-gray-200 hover:border-red-600 rounded-lg p-4 flex flex-col items-center gap-3 transition-colors duration-200 shadow-sm hover:shadow-md overflow-hidden">
            <div class="w-14 h-14 flex items-center justify-center group-hover:opacity-0 transition-opacity duration-200">
              <img src="{{ brand_imgs[forloop.index0] }}" alt="{{ name }}" class="max-w-full max-h-full object-contain">
            </div>
            <span class="text-xs font-bold tracking-wide uppercase text-gray-500 group-hover:text-white transition-colors duration-200">{{ name }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ── CATEGORIES ── -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12">
        <p class="text-red-600 text-xs font-bold uppercase tracking-[0.2em] mb-2">Browse</p>
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Shop by Category</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {%- assign cat_names = "Wiring,Mirrors,Headlights,Door Handles,Bumpers,Grilles,Radio,Engine Parts" | split: "," -%}
        {%- for name in cat_names -%}
          {%- assign handle = name | handleize -%}
          <a href="/collections/{{ handle }}" class="group relative bg-red-600 hover:bg-red-700 rounded-lg px-5 py-8 overflow-hidden transition-all duration-200">
            <span class="absolute right-3 top-2 text-6xl font-black text-white/10 select-none leading-none">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="relative font-bold text-white text-base tracking-wide">{{ name }}</h3>
            <div class="relative mt-2 flex items-center gap-1 text-xs text-red-200"><span>Browse</span> &rarr;</div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ── FEATURED PRODUCTS ── -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-red-600 text-xs font-bold uppercase tracking-[0.2em] mb-2">Hand-Picked</p>
          <h2 class="text-4xl font-black text-gray-900 tracking-tight">Featured Parts</h2>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="flex items-center gap-2 text-sm font-bold text-gray-900 hover:text-red-600 transition-colors uppercase tracking-wider border-b-2 border-gray-900 hover:border-red-600 pb-0.5">View All &rarr;</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {%- assign featured = collections.frontpage.products -%}
        {%- if featured == empty or featured.size == 0 -%}{%- assign featured = collections.all.products -%}{%- endif -%}
        {%- for product in featured limit: 8 -%}
          <a href="{{ product.url }}" class="group bg-white border border-gray-100 hover:border-red-500 hover:shadow-xl rounded-xl overflow-hidden transition-all duration-200 flex flex-col">
            <div class="aspect-square bg-white overflow-hidden relative flex items-center justify-center p-3">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300">
              {%- else -%}
                <img src="{{ 'logo.png' | asset_url }}" alt="{{ product.title | escape }}" class="max-w-[55%] max-h-[55%] object-contain opacity-25">
              {%- endif -%}
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 mb-3 group-hover:text-red-600 transition-colors leading-snug">{{ product.title }}</h3>
              <div class="flex items-center justify-between mt-auto">
                <p class="text-red-600 font-black text-lg">{{ product.price | money }}</p>
                <span class="text-xs font-bold bg-gray-900 group-hover:bg-red-600 text-white px-3 py-1.5 rounded-sm transition-colors uppercase tracking-wide">View</span>
              </div>
            </div>
          </a>
        {%- else -%}
          <p class="col-span-full text-center text-gray-400 py-10">Add products to your store to see them featured here.</p>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ── VALUE PROPS ── -->
  <section class="py-20 px-4 bg-[#111] relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-1 bg-red-600"></div>
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-red-500 text-xs font-bold uppercase tracking-[0.2em] mb-2">Why choose us</p>
        <h2 class="text-4xl font-black text-white tracking-tight">Built Different.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-xl p-8 hover:border-red-600/50 transition-colors">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-5 text-white text-2xl">⛁</div>
          <h3 class="text-white font-bold text-lg mb-2">Multi-Brand Selection</h3>
          <p class="text-gray-400 text-sm leading-relaxed">BMW, Chevrolet, Mazda, Toyota, Ford, Nissan and more — all under one roof.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-8 hover:border-red-600/50 transition-colors">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-5 text-white text-2xl">$</div>
          <h3 class="text-white font-bold text-lg mb-2">Cost-Effective</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Wholesale pricing for shops and resellers. Save more when you buy in volume.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-8 hover:border-red-600/50 transition-colors">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-5 text-white text-2xl">✓</div>
          <h3 class="text-white font-bold text-lg mb-2">Quality Assured</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Rigorous testing on every part before it leaves our warehouse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA STRIP ── -->
  <section class="bg-red-600 py-14 px-4">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-3xl font-black text-white tracking-tight">Ready to find your part?</h2>
        <p class="text-red-100 mt-1">Wholesale pricing available. Call us or browse the full catalog.</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="tel:3057169794" class="inline-flex items-center gap-2 bg-white text-red-600 font-black px-6 py-3.5 rounded-sm hover:bg-gray-100 transition-colors text-sm uppercase tracking-widest">📞 305 716 9794</a>
        <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 border-2 border-white text-white font-black px-6 py-3.5 rounded-sm hover:bg-white hover:text-red-600 transition-colors text-sm uppercase tracking-widest">Browse Catalog &rarr;</a>
      </div>
    </div>
  </section>

</div>
