<div class="bg-white min-h-screen">
  <div class="bg-[#111] border-b border-white/10 py-10 px-4 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-red-600"></div>
    <div class="max-w-7xl mx-auto pl-4">
      <h1 class="text-4xl font-black text-white tracking-tight">Collections</h1>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="group relative bg-red-600 hover:bg-red-700 rounded-lg px-5 py-8 overflow-hidden transition-all duration-200">
          <h3 class="relative font-bold text-white text-base tracking-wide">{{ collection.title }}</h3>
          <p class="relative text-xs text-red-200 mt-1">{{ collection.products_count }} parts</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
